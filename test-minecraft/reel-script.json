    { "at": 0.25, "end": 3.4, "text": "AIがAIのコードを、総点検した日", "style": "Title" },
    { "seg": "walkin", "rel": 0.4, "dur": 3.6, "text": "旧 Opus 4.8 ─▶ 新 Fable 5", "style": "Chip" },
    { "seg": "harvest", "rel": 0.4, "dur": 3.8, "text": "Dynamic workflows：3エージェント並列×22候補", "style": "Chip" },
