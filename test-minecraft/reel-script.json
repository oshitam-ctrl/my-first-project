    { "seg": "ferment",  "speaker": "tsumugi", "text": "ぷくぷくしてる…" },

    { "seg": "bake",     "speaker": "zunda",   "text": "工房で、焼くのだーっ！",
      "actions": [{ "do": "giveBakeIngredients", "offset": -0.3 }, { "do": "bakeOpen", "offset": 0.0 }, { "do": "bakeClick", "offset": 1.1 }] },
    { "seg": "bake",     "speaker": "tsumugi", "text": "いいにおいしてきそう〜",
      "actions": [{ "do": "panelClose", "offset": 0.9 }] },

    { "seg": "deliver",  "speaker": "metan",   "text": "店主の大下さんに届けると…",
      "actions": [{ "do": "deliverBread", "offset": 1.2 }] },

    { "seg": "queue",    "speaker": "zunda",   "text": "開店なのだ！もう行列なのだ！" },
    { "seg": "queue",    "speaker": "metan",   "text": "修正もテストも自動。人間は、承認ボタンを押しただけよ" },

    { "seg": "cafe",     "speaker": "tsumugi", "text": "実況の声も編集も、ぜんぶAI。しかも無料なんです",
      "actions": [{ "do": "cafeOrder", "offset": 1.0 }] },

    { "seg": "cta",      "speaker": "zunda",   "text": "ブラウザで無料で遊べるのだ！プロフのリンクなのだ！" },
    { "seg": "cta",      "speaker": "tsumugi", "text": "保存して、あとでゆっくりね" },

    { "seg": "endcard",  "speaker": "metan",   "text": "あなたのお店も、ゲームになるかもよ？" }
  ]
